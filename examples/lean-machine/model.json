{
  "ir_version": "0.6",
  "semantics": "flat-efsm-atomic-ordered-v1",
  "protocol": "typed-scheduled-microstep-contract",
  "scope": {
    "terminal_states": [],
    "excluded": [
      "batch advance/dispatch rollback",
      "protocol specification correctness",
      "native overflow and compiler proof"
    ]
  },
  "states": [
    "IDLE",
    "BUSY",
    "DONE"
  ],
  "initial_state": "IDLE",
  "requirements": {
    "TRANSACTION": {
      "source": "spec.md#contract",
      "interpretation": "Explicit admitted IR ordered transaction and scheduled microstep contract."
    }
  },
  "variables": {
    "n": {
      "type": "int",
      "initial": 0
    },
    "flag": {
      "type": "bool",
      "initial": false
    },
    "seq": {
      "type": "seq32",
      "initial": 4294967295
    },
    "data": {
      "type": "bytes",
      "initial": []
    },
    "text": {
      "type": "string",
      "initial": "start"
    }
  },
  "events": {
    "start": {
      "origin": "application",
      "fields": {
        "payload": "bytes"
      }
    },
    "bad_delay": {
      "origin": "application",
      "fields": {
        "delay": "int"
      }
    },
    "bad_final": {
      "origin": "application",
      "fields": {}
    },
    "rearm": {
      "origin": "application",
      "fields": {}
    },
    "ambiguous": {
      "origin": "application",
      "fields": {}
    },
    "gap": {
      "origin": "network",
      "fields": {}
    },
    "a.expired": {
      "origin": "timer",
      "fields": {}
    },
    "z.expired": {
      "origin": "timer",
      "fields": {}
    }
  },
  "messages": {
    "observed": {
      "fields": {
        "n": "int",
        "flag": "bool",
        "seq": "seq32",
        "data": "bytes",
        "text": "string",
        "source_idle": "bool",
        "fired_active": "bool",
        "other_active": "bool"
      }
    }
  },
  "timers": {
    "z": {
      "event": "z.expired"
    },
    "a": {
      "event": "a.expired"
    }
  },
  "transitions": [
    {
      "id": "START",
      "from": "IDLE",
      "to": "BUSY",
      "event": "start",
      "guard": true,
      "actions": [
        {
          "set": {
            "var": "data",
            "value": {
              "event": "payload"
            }
          }
        },
        {
          "set": {
            "var": "n",
            "value": 4
          }
        },
        {
          "set": {
            "var": "n",
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "n"
                },
                1
              ]
            }
          }
        },
        {
          "set": {
            "var": "flag",
            "value": true
          }
        },
        {
          "set": {
            "var": "seq",
            "value": {
              "op": "seq_add",
              "args": [
                {
                  "var": "seq"
                },
                1
              ]
            }
          }
        },
        {
          "set": {
            "var": "text",
            "value": "开\n\u0000"
          }
        },
        {
          "emit": {
            "message": "observed",
            "fields": {
              "n": {
                "var": "n"
              },
              "flag": {
                "var": "flag"
              },
              "seq": {
                "var": "seq"
              },
              "data": {
                "var": "data"
              },
              "text": {
                "var": "text"
              },
              "source_idle": {
                "state": "IDLE"
              },
              "fired_active": {
                "timer_active": "a"
              },
              "other_active": {
                "timer_active": "z"
              }
            }
          }
        },
        {
          "arm": {
            "timer": "z",
            "delay_ms": 5
          }
        },
        {
          "arm": {
            "timer": "a",
            "delay_ms": 5
          }
        }
      ],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "BAD-DELAY",
      "from": "IDLE",
      "to": "BUSY",
      "event": "bad_delay",
      "guard": true,
      "actions": [
        {
          "set": {
            "var": "n",
            "value": 10
          }
        },
        {
          "emit": {
            "message": "observed",
            "fields": {
              "n": {
                "var": "n"
              },
              "flag": {
                "var": "flag"
              },
              "seq": {
                "var": "seq"
              },
              "data": {
                "var": "data"
              },
              "text": {
                "var": "text"
              },
              "source_idle": {
                "state": "IDLE"
              },
              "fired_active": {
                "timer_active": "a"
              },
              "other_active": {
                "timer_active": "z"
              }
            }
          }
        },
        {
          "arm": {
            "timer": "a",
            "delay_ms": {
              "event": "delay"
            }
          }
        }
      ],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "BAD-FINAL",
      "from": "IDLE",
      "to": "DONE",
      "event": "bad_final",
      "guard": true,
      "actions": [
        {
          "set": {
            "var": "n",
            "value": -1
          }
        },
        {
          "arm": {
            "timer": "a",
            "delay_ms": 5
          }
        },
        {
          "emit": {
            "message": "observed",
            "fields": {
              "n": {
                "var": "n"
              },
              "flag": {
                "var": "flag"
              },
              "seq": {
                "var": "seq"
              },
              "data": {
                "var": "data"
              },
              "text": {
                "var": "text"
              },
              "source_idle": {
                "state": "IDLE"
              },
              "fired_active": {
                "timer_active": "a"
              },
              "other_active": {
                "timer_active": "z"
              }
            }
          }
        }
      ],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "A",
      "from": "BUSY",
      "to": "BUSY",
      "event": "a.expired",
      "guard": {
        "timer_active": "a"
      },
      "actions": [
        {
          "set": {
            "var": "n",
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "n"
                },
                1
              ]
            }
          }
        },
        {
          "emit": {
            "message": "observed",
            "fields": {
              "n": {
                "var": "n"
              },
              "flag": {
                "var": "flag"
              },
              "seq": {
                "var": "seq"
              },
              "data": {
                "var": "data"
              },
              "text": {
                "var": "text"
              },
              "source_idle": {
                "state": "IDLE"
              },
              "fired_active": {
                "timer_active": "a"
              },
              "other_active": {
                "timer_active": "z"
              }
            }
          }
        }
      ],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "Z",
      "from": "BUSY",
      "to": "DONE",
      "event": "z.expired",
      "guard": {
        "timer_active": "z"
      },
      "actions": [
        {
          "set": {
            "var": "n",
            "value": {
              "op": "add",
              "args": [
                {
                  "var": "n"
                },
                1
              ]
            }
          }
        },
        {
          "emit": {
            "message": "observed",
            "fields": {
              "n": {
                "var": "n"
              },
              "flag": {
                "var": "flag"
              },
              "seq": {
                "var": "seq"
              },
              "data": {
                "var": "data"
              },
              "text": {
                "var": "text"
              },
              "source_idle": {
                "state": "IDLE"
              },
              "fired_active": {
                "timer_active": "a"
              },
              "other_active": {
                "timer_active": "z"
              }
            }
          }
        },
        {
          "cancel": "a"
        }
      ],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "REARM",
      "from": "BUSY",
      "to": "BUSY",
      "event": "rearm",
      "guard": true,
      "actions": [
        {
          "arm": {
            "timer": "a",
            "delay_ms": 3
          }
        },
        {
          "arm": {
            "timer": "a",
            "delay_ms": 7
          }
        },
        {
          "cancel": "z"
        },
        {
          "emit": {
            "message": "observed",
            "fields": {
              "n": {
                "var": "n"
              },
              "flag": {
                "var": "flag"
              },
              "seq": {
                "var": "seq"
              },
              "data": {
                "var": "data"
              },
              "text": {
                "var": "text"
              },
              "source_idle": {
                "state": "IDLE"
              },
              "fired_active": {
                "timer_active": "a"
              },
              "other_active": {
                "timer_active": "z"
              }
            }
          }
        }
      ],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "CONFLICT-1",
      "from": "IDLE",
      "to": "IDLE",
      "event": "ambiguous",
      "guard": true,
      "actions": [],
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "CONFLICT-2",
      "from": "IDLE",
      "to": "BUSY",
      "event": "ambiguous",
      "guard": true,
      "actions": [],
      "requirements": [
        "TRANSACTION"
      ]
    }
  ],
  "invariants": [
    {
      "id": "NONNEGATIVE",
      "assert": {
        "op": "ge",
        "args": [
          {
            "var": "n"
          },
          0
        ]
      },
      "requirements": [
        "TRANSACTION"
      ]
    },
    {
      "id": "BUFFER",
      "assert": {
        "op": "le",
        "args": [
          {
            "op": "bytes_len",
            "args": [
              {
                "var": "data"
              }
            ]
          },
          4096
        ]
      },
      "requirements": [
        "TRANSACTION"
      ]
    }
  ]
}
